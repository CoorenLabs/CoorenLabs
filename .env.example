PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public URL of this API, used in proxied stream links (required in production)
SERVER_ORIGIN=http://localhost:3000

# Allowed CORS origins: * or a comma-separated list of URLs
CORS_ORIGIN=*

# Allow credentials (cookies) on cross-origin requests
CORS_CREDENTIALS=false

# Redis URL, e.g. redis://localhost:6379 (caching turns on when set; Bun only)
REDIS_URL=
