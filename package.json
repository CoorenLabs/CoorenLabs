{
  "name": "cooren",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "hot": "bun run --hot src/index.ts",
    "dev:node": "tsx --env-file=.env src/index.ts",
    "dev:deno": "deno run -A --env --unstable-fs --sloppy-imports src/index.ts",
    "start": "bun run src/index.ts",
    "start:node": "node dist/index.js",
    "build:bun": "bun build src/index.ts src/providers/anime/anivexa/extractors/proof.js --target bun --outdir dist --entry-naming [name].[ext] --minify --sourcemap --packages external",
    "build:node": "bun build src/index.ts src/providers/anime/anivexa/extractors/proof.js --target node --outdir dist --entry-naming [name].[ext] --packages external",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.14",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.36.3",
    "cheerio": "^1.2.0",
    "elysia": "^1.4.27",
    "puppeteer-real-browser": "^1.4.4",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.12.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.2"
  }
}
